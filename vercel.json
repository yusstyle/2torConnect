{
  "version": 2,
  "installCommand": "pnpm install",
  "buildCommand": "pnpm run vercel-build",
  "outputDirectory": "artifacts/web-app/dist/public",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/[[...slug]]"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "/api/[[...slug]]"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
