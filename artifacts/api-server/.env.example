# Copy this file to .env and fill in the values before running the API server.
DATABASE_URL=postgres://username:password@localhost:5432/mydatabase
# Optional alternate env name used by lib/db/drizzle.config.ts
NEON_DATABASE_URL=
PORT=8080

# Outgoing Email Configuration (Smartweb Business Email / Generic SMTP)
SMTP_HOST=us3.smtp.mailhostbox.com
SMTP_PORT=587
SMTP_USER=support@2torconnect.com
SMTP_PASS=your_mailbox_password_here
EMAIL_FROM=support@2torconnect.com
